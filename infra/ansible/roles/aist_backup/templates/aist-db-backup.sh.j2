#!/usr/bin/env bash
set -euo pipefail
umask 077

PROJECT_DIR={{ project_dir | quote }}
COMPOSE_ENV_FILE={{ compose_env_file | quote }}
COMPOSE_FILE={{ compose_file | quote }}
BACKUP_DIR={{ backup_dir | quote }}
RETENTION_DAYS={{ backup_retention_days | string | quote }}
REMOTE={{ deployment.backup_remote | quote }}

mkdir -p "${BACKUP_DIR}"
exec 9>"${BACKUP_DIR}/.backup.lock"
flock -n 9 || exit 0
STAMP="$(date -u +%Y%m%d_%H%M%S)"
OUT_FILE="${BACKUP_DIR}/aist_${STAMP}.dump"
TMP_FILE="${OUT_FILE}.partial"

cd "${PROJECT_DIR}"
compose=(python3 "$PROJECT_DIR/scripts/deployment_config.py" --project-dir "$PROJECT_DIR"
  --env-file "$COMPOSE_ENV_FILE" --compose-file "$COMPOSE_FILE" --compose)
"${compose[@]}" exec -T postgres sh -c 'pg_dump -Fc -U "$POSTGRES_USER" "$POSTGRES_DB"' > "${TMP_FILE}"
test -s "${TMP_FILE}"
"${compose[@]}" exec -T postgres pg_restore --list < "${TMP_FILE}" > /dev/null
mv "${TMP_FILE}" "${OUT_FILE}"
(
  cd "${BACKUP_DIR}"
  sha256sum "$(basename "${OUT_FILE}")" > "${OUT_FILE}.sha256"
)
if [[ -n "${REMOTE}" ]]; then
  rclone copyto "${OUT_FILE}" "${REMOTE%/}/$(basename "${OUT_FILE}")"
  rclone copyto "${OUT_FILE}.sha256" "${REMOTE%/}/$(basename "${OUT_FILE}").sha256"
fi
# Retention runs only after dump validation and successful off-host upload when configured.
find "${BACKUP_DIR}" -maxdepth 1 -type f \( -name 'aist_*.dump' -o -name 'aist_*.dump.sha256' \) -mtime "+${RETENTION_DAYS}" -delete
printf 'Backup completed: %s\n' "${OUT_FILE}"
